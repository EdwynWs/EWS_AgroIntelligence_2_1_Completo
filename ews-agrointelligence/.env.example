NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Production: postgres. sqlite is local/test only.
DB_DRIVER=sqlite
SQLITE_PATH=.data/agro.sqlite
DATABASE_URL=postgresql://agro:CHANGE_ME@localhost:5432/agro
ENABLE_DEMO=true
# Required by seed/bootstrap; choose strong unique passwords.
DEMO_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 64 hex characters, for encrypting MFA secrets. Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
TELEMETRY_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
EDGE_API_URL=http://127.0.0.1:4000
EDGE_ALLOW_LOCAL_HTTP=true
EDGE_TOKEN=
EDGE_TAG_ID=
EDGE_UNIT=C
EDGE_BUFFER_PATH=.data/edge.sqlite
EDGE_MAX_BUFFER=100000
WEBHOOK_SECRET=

# Docker Compose production (hex-only password keeps URL encoding unambiguous)
POSTGRES_PASSWORD=
TRUST_PROXY=0
ENABLE_BILLING_WEBHOOK=false
WEB_PORT=3000
API_PORT=4000

# HTTPS import sources: exact public DNS hostnames, comma-separated; no wildcards.
# Keep empty to deny remote file downloads. Credentials are stored encrypted via MFA_ENCRYPTION_KEY.
IMPORT_ALLOWED_HOSTS=
